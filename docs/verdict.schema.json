{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Probative verdict, version 0.1",
  "description": "Signed result of verifying one manifest. The signature covers the RFC 8785 (JCS) serialization of the verdict without its signature field. Conventions: sections that do not apply (inconclusive_reason, inconclusive_detail, finding, severity_hint, fix) are omitted; values that may be missing inside an object (exit_code, signature, event, fix_commit, dedup_signature) are null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "created_at",
    "tool_version",
    "manifest_sha256",
    "target",
    "build",
    "poc",
    "runs",
    "outcome",
    "claim_match",
    "dedup_signature",
    "duplicates_of",
    "repro",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "id": {
      "description": "UUID v7.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "created_at": {
      "description": "RFC 3339 timestamp in UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "tool_version": {
      "type": "string",
      "pattern": "^probative [0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "manifest_sha256": {
      "description": "SHA-256 of the manifest bytes.",
      "$ref": "#/$defs/sha256"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_url", "commit", "fix_commit"],
      "properties": {
        "repo_url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
        "commit": { "$ref": "#/$defs/gitSha" },
        "fix_commit": { "anyOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe", "sanitizer"],
      "properties": {
        "recipe": { "enum": ["oss_fuzz", "arvo", "manual"] },
        "sanitizer": { "$ref": "#/$defs/sanitizer" },
        "build_image_digest": { "$ref": "#/$defs/imageDigest" },
        "base_image_digest": { "$ref": "#/$defs/imageDigest" },
        "oss_fuzz_commit": { "$ref": "#/$defs/gitSha" },
        "arvo_id": { "type": "string", "pattern": "^[0-9]{1,12}$" },
        "manual": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
      },
      "allOf": [
        {
          "if": { "required": ["recipe"], "properties": { "recipe": { "const": "oss_fuzz" } } },
          "then": { "required": ["oss_fuzz_commit"], "properties": { "arvo_id": false, "manual": false } }
        },
        {
          "if": { "required": ["recipe"], "properties": { "recipe": { "const": "arvo" } } },
          "then": { "required": ["arvo_id"], "properties": { "oss_fuzz_commit": false, "manual": false } }
        },
        {
          "if": { "required": ["recipe"], "properties": { "recipe": { "const": "manual" } } },
          "then": { "required": ["manual"], "properties": { "oss_fuzz_commit": false, "arvo_id": false } }
        }
      ]
    },
    "poc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sha256"],
      "properties": {
        "type": { "enum": ["fuzz_input", "cli", "harness"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fuzz_target": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+-]{0,127}$" },
        "binary": { "type": "string", "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.+-]{0,127}$" },
        "argv": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 4096 } },
        "lang": { "enum": ["c", "cpp"] }
      },
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "fuzz_input" } } },
          "then": { "required": ["fuzz_target"], "properties": { "binary": false, "argv": false, "lang": false } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "cli" } } },
          "then": { "required": ["binary", "argv"], "properties": { "fuzz_target": false, "lang": false } }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "harness" } } },
          "then": { "required": ["lang"], "properties": { "fuzz_target": false, "binary": false, "argv": false } }
        }
      ]
    },
    "run_image_digest": {
      "description": "Digest of the run image (build image plus PoC). Absent only when the build failed.",
      "$ref": "#/$defs/imageDigest"
    },
    "runs": {
      "description": "One entry per run: three when the build succeeded, none when it failed.",
      "type": "array",
      "items": { "$ref": "#/$defs/run" }
    },
    "outcome": { "$ref": "#/$defs/outcome" },
    "inconclusive_reason": {
      "enum": [
        "build_failed",
        "flaky",
        "crash_in_dependency",
        "no_sanitizer_report",
        "unsymbolized",
        "timeout",
        "resource_limit"
      ]
    },
    "inconclusive_detail": {
      "description": "Optional detail for the reason, for example build_timeout.",
      "type": "string",
      "maxLength": 256
    },
    "finding": {
      "description": "The sanitizer finding shared by the runs. Present when outcome is reproduced, and for some inconclusive results.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sanitizer", "kind", "access", "top_project_frames", "summary_line"],
      "properties": {
        "sanitizer": { "$ref": "#/$defs/sanitizer" },
        "kind": { "$ref": "#/$defs/bugKind" },
        "access": { "enum": ["read", "write", null] },
        "top_project_frames": {
          "description": "Up to five normalized function names from project frames, innermost first.",
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "summary_line": { "type": "string", "maxLength": 1024 }
      }
    },
    "claim_match": {
      "description": "matches or different only when outcome is reproduced; unknown otherwise.",
      "enum": ["matches", "different", "unknown"]
    },
    "severity_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "rationale", "source"],
      "properties": {
        "value": { "enum": ["low", "medium", "high"] },
        "rationale": { "type": "string", "maxLength": 512 },
        "source": { "const": "heuristic" }
      }
    },
    "fix": {
      "description": "Result of the same three runs on the fix commit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "outcome"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitSha" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "fixed_by_commit": {
          "description": "true if the fix outcome is not_reproduced, false if it is reproduced with the same signature. Omitted otherwise, with a note.",
          "type": "boolean"
        },
        "note": { "type": "string", "maxLength": 512 }
      },
      "if": { "not": { "required": ["fixed_by_commit"] } },
      "then": { "required": ["note"] }
    },
    "dedup_signature": {
      "description": "SHA-256 of the bug kind, access and first three normalized project frames. null when there is no project frame.",
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "duplicates_of": {
      "description": "IDs of stored verdicts with the same dedup signature and repository.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "repro": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "command"],
      "properties": {
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "command": { "type": "string", "pattern": "^probative verify ", "maxLength": 1024 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "public_key", "value"],
      "properties": {
        "alg": { "const": "ed25519" },
        "key_id": {
          "description": "First 16 hex characters of the SHA-256 of the public key.",
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "public_key": {
          "description": "Ed25519 public key (32 bytes), standard base64 with padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "value": {
          "description": "Ed25519 signature (64 bytes), standard base64 with padding.",
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  },
  "dependentRequired": {
    "severity_hint": ["finding"],
    "inconclusive_detail": ["inconclusive_reason"]
  },
  "allOf": [
    {
      "description": "inconclusive_reason is present if and only if the outcome is inconclusive.",
      "if": { "required": ["outcome"], "properties": { "outcome": { "const": "inconclusive" } } },
      "then": { "required": ["inconclusive_reason"] },
      "else": { "properties": { "inconclusive_reason": false, "inconclusive_detail": false } }
    },
    {
      "description": "A reproduced verdict has a finding, a severity hint and a dedup signature.",
      "if": { "required": ["outcome"], "properties": { "outcome": { "const": "reproduced" } } },
      "then": {
        "required": ["finding", "severity_hint"],
        "properties": { "dedup_signature": { "type": "string" } }
      },
      "else": { "properties": { "claim_match": { "const": "unknown" } } }
    },
    {
      "description": "A not_reproduced verdict has no finding and no signature.",
      "if": { "required": ["outcome"], "properties": { "outcome": { "const": "not_reproduced" } } },
      "then": {
        "properties": { "finding": false, "severity_hint": false, "dedup_signature": { "type": "null" } }
      }
    },
    {
      "description": "Without a successful build there are no runs and no run image; otherwise there are exactly three runs.",
      "if": {
        "required": ["inconclusive_reason"],
        "properties": { "inconclusive_reason": { "const": "build_failed" } }
      },
      "then": {
        "properties": { "runs": { "maxItems": 0 }, "run_image_digest": false, "finding": false }
      },
      "else": {
        "required": ["run_image_digest"],
        "properties": {
          "runs": { "minItems": 3, "maxItems": 3 },
          "build": { "required": ["build_image_digest", "base_image_digest"] }
        }
      }
    }
  ],
  "$defs": {
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sanitizer": { "enum": ["address", "undefined"] },
    "outcome": { "enum": ["reproduced", "not_reproduced", "inconclusive"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "wall_ms", "oom_killed", "timed_out", "signature", "event"],
      "properties": {
        "exit_code": { "type": ["integer", "null"] },
        "wall_ms": { "type": "integer", "minimum": 0 },
        "oom_killed": { "type": "boolean" },
        "timed_out": { "type": "boolean" },
        "signature": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "event": { "enum": ["timeout", "out_of_memory", "deadly_signal", null] }
      }
    },
    "bugKind": {
      "enum": [
        "heap-buffer-overflow",
        "stack-buffer-overflow",
        "global-buffer-overflow",
        "heap-use-after-free",
        "stack-use-after-return",
        "double-free",
        "invalid-free",
        "stack-overflow",
        "null-deref",
        "segv-unknown-address",
        "signed-integer-overflow",
        "shift",
        "division-by-zero",
        "out-of-bounds-index",
        "misaligned-access",
        "other"
      ]
    }
  }
}
